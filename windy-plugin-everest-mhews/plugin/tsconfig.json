{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "lib": ["es2022", "DOM"],
        "noImplicitAny": true,
        "removeComments": true,
        "outDir": "dist",
        "target": "es2022",
        "typeRoots": ["./node_modules/@types/", "./node_modules/@windycom/plugin-devtools/types"],
        "noEmit": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "paths": {
            "@windy/*": [
                "./node_modules/@windycom/plugin-devtools/types/*",
                "./node_modules/@windycom/plugin-devtools/types/client/*"
            ]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.svelte"]
}
