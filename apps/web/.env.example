# Everest frontend environment (non-secret; copy to .env.local)
# The Everest-owned backend API origin. The frontend never calls external providers.
# Ports: random non-standard (AGENTS.md): frontend 52148, API 52147.
# Next.js server port is set by the package dev/start commands, not this file.
NEXT_PUBLIC_EVEREST_API_BASE_URL=http://localhost:52147

# Cesium ion access token (optional). Enables Cesium World Terrain (global
# real terrain) and ion-hosted 3D Tiles. Create at https://ion.cesium.com/tokens
# with scopes restricted to assets:read and Allowed URLs limited to your app
# origin (e.g. http://localhost:50151). Never commit a real token; copy the
# production value into .env.local which is gitignored.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
