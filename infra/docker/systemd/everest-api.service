[Unit]
Description=Everest backend API (RUNTIME-006)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/mnt/d/Everest/apps/api
EnvironmentFile=/root/.everest/db.env
Environment=PYTHONPATH=/mnt/d/Everest:/mnt/d/Everest/apps/api:/mnt/d/Everest/packages/weather_ingestion_contract
Environment=EVEREST_API_PORT=52147
Environment=EVEREST_DB_HOST=127.0.0.1
Environment=EVEREST_WIND_FIELD_DERIVED_ROOT=/var/lib/everest/derived
# The DSN is composed by everest_api.persistence.database.resolve_database_url()
# from EVEREST_DB_* in the EnvironmentFile. Do not inline a URL here: an inlined
# one is how the API and the scheduler drifted onto two different databases.
ExecStart=/usr/bin/python3 run_dev.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
