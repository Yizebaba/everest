[Unit]
Description=Everest forecast scheduler run
After=network.target docker.service everest-api.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/d/Everest/apps/api
EnvironmentFile=/root/.everest/db.env
Environment=PYTHONPATH=/mnt/d/Everest:/mnt/d/Everest/apps/api:/mnt/d/Everest/packages/weather_ingestion_contract
ExecStart=/usr/bin/python3 schedule_forecast.py
