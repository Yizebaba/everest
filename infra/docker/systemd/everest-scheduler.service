[Unit]
Description=Everest forecast scheduler run
After=network.target docker.service everest-api.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/d/Everest/apps/api
EnvironmentFile=/root/.everest/db.env
Environment=PYTHONPATH=/mnt/d/Everest:/mnt/d/Everest/apps/api:/mnt/d/Everest/packages/weather_ingestion_contract
Environment=EVEREST_DB_HOST=127.0.0.1
Environment=EVEREST_WIND_FIELD_DERIVED_ROOT=/var/lib/everest/derived
# Without this, Python block-buffers stdout into the journal pipe and a run that
# takes 20 min logs nothing until it exits, so a stuck ingest is
# indistinguishable from a slow one.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 schedule_forecast.py
