    {"source":"DWD ICON","prefix":"dwd-icon","roleName":"everest-writer-dwd-icon","profileName":"everest-profile-dwd-icon","certificateSubject":"everest/dwd-icon/${WORKLOAD_UUID}"},
    {"source":"ECMWF AIFS","prefix":"ecmwf-aifs","roleName":"everest-writer-ecmwf-aifs","profileName":"everest-profile-ecmwf-aifs","certificateSubject":"everest/ecmwf-aifs/${WORKLOAD_UUID}"}
